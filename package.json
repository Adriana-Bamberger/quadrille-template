{
	"name": "quadrille-template",
	"description": "A static site template built around interactive isometric 3D grids.",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"author": "Adriana Bamberger <https://adriana.bamberger.nz/>",
	"license": "UNLICENSED",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "npm run test:unit -- --run",
		"test:unit": "vitest",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"shots": "npm run build && node scripts/shoot.mjs",
		"a11y": "npm run build && node scripts/audit-a11y.mjs",
		"placeholders": "node scripts/generate-placeholders.mjs",
		"prepare": "svelte-kit sync || echo ''"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@storybook/addon-a11y": "^10.6.1",
		"@storybook/addon-svelte-csf": "^5.1.5",
		"@storybook/sveltekit": "^10.6.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.11",
		"axe-core": "^4.14.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"storybook": "^10.6.1",
		"svelte": "^5.56.7",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"dynamics.js": "^1.1.5",
		"imagesloaded": "^5.0.0",
		"masonry-layout": "^4.2.2"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
